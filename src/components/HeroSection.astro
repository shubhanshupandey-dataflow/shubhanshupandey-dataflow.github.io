---
import Icon from "./Icon.astro";
import { getSection, getSite } from "../lib/content";

const brand = await getSite("brand");
const hero = await getSection("hero");
const { headline, form, ctas, trustPoints, badge, subheading } = hero;
const secondaryCta = ctas[0];
---

<section class="relative bg-white">
  <div class="relative max-w-4xl mx-auto px-6 pt-24 pb-28 text-center">
    <div
      class="anim anim-up inline-flex items-center gap-2 bg-[#13b5ea]/10 text-[#13b5ea] text-xs font-bold px-4 py-2 rounded-full mb-7 uppercase tracking-widest"
      style="--anim-delay: 0.1s"
    >
      <Icon name="Sparkles" size={12} />
      {badge}
    </div>

    <h1
      class="anim anim-up text-5xl sm:text-6xl font-bold text-gray-900 leading-[1.05] tracking-tight mb-6"
      style="--anim-delay: 0.2s"
    >
      {headline?.before} <span class="text-[#13b5ea]">{headline?.accent}</span>{" "}
      {headline?.after}
    </h1>

    <p
      class="anim anim-up text-lg text-gray-600 leading-relaxed mb-10 max-w-xl mx-auto"
      style="--anim-delay: 0.3s"
    >
      {subheading}
    </p>

    {/* Prominent email lead magnet */}
    <div class="anim anim-up max-w-2xl mx-auto" style="--anim-delay: 0.4s">
      <div data-hero-success hidden>
        <div
          class="flex items-center justify-center gap-3 bg-[#13b5ea]/10 text-slate-800 rounded-2xl px-6 py-5 max-w-lg mx-auto"
        >
          <Icon name="CheckCircle2" size={24} class="text-[#13b5ea] shrink-0" />
          <p class="text-sm font-medium text-left">{form?.successMessage}</p>
        </div>
      </div>

      <div data-hero-idle>
        <form
          data-hero-form
          data-source={form?.source}
          data-error={form?.errorMessage}
          data-connection-error={form?.connectionErrorMessage}
          class="flex flex-col sm:flex-row gap-3 bg-white p-3 rounded-2xl shadow-xl shadow-[#13b5ea]/15 border-2 border-[#13b5ea]/20 transition-all focus-within:border-[#13b5ea] focus-within:shadow-[#13b5ea]/30"
        >
          <input type="hidden" name="access_key" value={brand.formAccessKey} />
          <input type="hidden" name="source" value={form?.source} />
          <label for="hero-email" class="sr-only">{form?.placeholder}</label>
          <input
            id="hero-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder={form?.placeholder}
            class="flex-1 bg-transparent text-slate-900 text-base rounded-xl px-5 py-4 placeholder-slate-400 focus:outline-none"
          />
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 bg-[#13b5ea] text-white font-semibold px-8 py-4 rounded-xl hover:bg-[#0e9fd2] transition-colors text-base shadow-lg shadow-[#13b5ea]/30 disabled:cursor-not-allowed whitespace-nowrap cursor-pointer"
          >
            <span data-label class="inline-flex items-center gap-2">
              {form?.submitLabel}
              <Icon name="ArrowRight" size={18} />
            </span>
            <span data-loading class="inline-flex items-center gap-2" hidden>
              <Icon name="Loader" size={18} class="animate-spin" />
              {form?.loadingLabel}
            </span>
          </button>
        </form>
        <p data-hero-error class="text-sm text-red-600 mt-2" hidden></p>
        {
          secondaryCta && (
            <a
              href={secondaryCta.href}
              class="inline-block text-sm text-gray-500 hover:text-gray-800 font-medium mt-4 transition-colors"
            >
              {secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>

    <div
      class="anim anim-fade flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-10 text-sm text-gray-500"
      style="--anim-delay: 0.6s"
    >
      {
        trustPoints.map((point) => (
          <span class="flex items-center gap-1.5">
            <Icon name="Check" size={14} class="text-[#13b5ea]" />
            {point}
          </span>
        ))
      }
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-hero-form]");

  if (form) {
    const idle = document.querySelector<HTMLElement>("[data-hero-idle]")!;
    const success = document.querySelector<HTMLElement>("[data-hero-success]")!;
    const errorEl = document.querySelector<HTMLElement>("[data-hero-error]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector<HTMLElement>("[data-label]")!;
    const loading = button.querySelector<HTMLElement>("[data-loading]")!;
    const input = form.querySelector<HTMLInputElement>("input[name=email]")!;

    let emailStarted = false;
    input.addEventListener("input", () => {
      if (!emailStarted && input.value.length > 0) {
        emailStarted = true;
        window.gtag?.("event", "email_started", {
          event_category: "engagement",
          event_label: "hero",
        });
      }
    });

    button.addEventListener("click", () => {
      window.gtag?.("event", "cta_click", { event_category: "engagement", event_label: "hero" });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      label.hidden = true;
      loading.hidden = false;
      errorEl.hidden = true;

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });
        const data = await response.json();

        if (data.success) {
          localStorage.setItem("ledgerSignedUp", "true");
          window.gtag?.("event", "form_submitted", {
            event_category: "conversion",
            event_label: "hero",
          });
          idle.hidden = true;
          success.hidden = false;
        } else {
          errorEl.textContent = form.dataset.error!;
          errorEl.hidden = false;
        }
      } catch {
        errorEl.textContent = form.dataset.connectionError!;
        errorEl.hidden = false;
      } finally {
        button.disabled = false;
        label.hidden = false;
        loading.hidden = true;
      }
    });
  }
</script>
