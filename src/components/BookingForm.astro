---
import Icon from "./Icon.astro";
import { getSection, getSite } from "../lib/content";

const brand = await getSite("brand");
const { form } = await getSection("book-demo");
---

{
  form && (
    <div>
      <div data-booking-success hidden>
        <div class="text-center py-8">
          <div class="w-16 h-16 bg-[#13b5ea]/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <Icon name="CheckCircle2" size={28} class="text-[#13b5ea]" />
          </div>
          <h3 class="text-slate-900 font-bold text-xl mb-2">{form.successTitle}</h3>
          <p class="text-slate-500 text-sm mb-1">{form.successMessage}</p>
          <p class="text-slate-400 text-sm">
            We'll send a confirmation to <span data-booking-email />
          </p>
        </div>
      </div>

      <form
        data-booking-form
        data-conversion={brand.bookingConversionLabel}
        data-error={form.errorMessage}
        data-connection-error={form.connectionErrorMessage}
        class="space-y-4"
      >
        <input type="hidden" name="access_key" value={brand.formAccessKey} />
        <input type="hidden" name="source" value={form.source} />

        {form.fields.map((field) => (
          <>
            <label for={`booking-${field.name}`} class="sr-only">
              {field.placeholder}
            </label>
            <input
              id={`booking-${field.name}`}
              type={field.type}
              name={field.name}
              placeholder={field.placeholder}
              required={field.required}
              class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl px-4 py-3 placeholder-slate-400 focus:outline-none focus:border-[#13b5ea] focus:bg-white transition-all"
            />
          </>
        ))}

        <div data-booking-status class="text-sm p-3 rounded-lg" hidden />

        <button
          type="submit"
          class="w-full bg-[#13b5ea] text-white font-semibold py-3.5 rounded-xl hover:bg-[#0e9fd2] transition-colors text-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          <span data-label>{form.submitLabel}</span>
          <span data-loading class="inline-flex items-center gap-2" hidden>
            <Icon name="Loader" size={15} class="animate-spin" />
            {form.loadingLabel}
          </span>
        </button>

        <p class="text-xs text-slate-400 text-center">{form.note}</p>
      </form>
    </div>
  )
}

<script>
  const form = document.querySelector<HTMLFormElement>("[data-booking-form]");

  if (form) {
    const success = document.querySelector<HTMLElement>("[data-booking-success]")!;
    const emailOut = document.querySelector<HTMLElement>("[data-booking-email]")!;
    const status = form.querySelector<HTMLElement>("[data-booking-status]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector<HTMLElement>("[data-label]")!;
    const loading = button.querySelector<HTMLElement>("[data-loading]")!;

    const setStatus = (message: string, ok: boolean) => {
      status.textContent = message;
      status.className = `text-sm p-3 rounded-lg ${
        ok ? "bg-green-50 text-green-700" : "bg-red-50 text-red-700"
      }`;
      status.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      label.hidden = true;
      loading.hidden = false;
      setStatus("Sending....", true);

      const data = new FormData(form);
      const email = String(data.get("email") ?? "");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: data,
        });
        const result = await response.json();

        if (result.success) {
          // Google Ads conversion
          window.gtag?.("event", "conversion", {
            send_to: form.dataset.conversion,
            value: 1.0,
            currency: "INR",
          });
          emailOut.textContent = email;
          form.hidden = true;
          success.hidden = false;
        } else {
          setStatus(form.dataset.error!, false);
          button.disabled = false;
        }
      } catch {
        setStatus(form.dataset.connectionError!, false);
        button.disabled = false;
      } finally {
        label.hidden = false;
        loading.hidden = true;
      }
    });
  }
</script>
